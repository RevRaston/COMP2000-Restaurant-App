<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.COMP2000RestaurantApp">

        <!-- 🚀 ENTRY POINT -->
        <activity
            android:name="com.example.comp2000restaurantapp.ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 🔐 AUTH -->
        <activity
            android:name="com.example.comp2000restaurantapp.ui.auth.RegisterActivity"/>
        <activity
            android:name="com.example.comp2000restaurantapp.ui.auth.ForgotPasswordActivity"/>

        <!-- 🏠 HOME -->
        <activity
            android:name="com.example.comp2000restaurantapp.ui.home.HomeActivity"/>
        <activity
            android:name="com.example.comp2000restaurantapp.ui.home.GuestHomeActivity"/>
        <activity
            android:name="com.example.comp2000restaurantapp.ui.home.StaffHomeActivity"/>

        <!-- 🍽 MENU -->
        <activity
            android:name="com.example.comp2000restaurantapp.ui.guest.MenuActivity"/>

        <!-- 📅 RESERVATIONS -->
        <activity
            android:name="com.example.comp2000restaurantapp.ui.guest.ReservationActivity"/>

        <!-- 👤 ACCOUNT / SETTINGS -->
        <activity
            android:name="com.example.comp2000restaurantapp.ui.user.AccountActivity"/>
        <activity
            android:name="com.example.comp2000restaurantapp.ui.settings.SettingsActivity"/>

        <!-- 🧑‍💼 STAFF -->
        <activity
            android:name="com.example.comp2000restaurantapp.ui.staff.StaffDashboardActivity"/>

        <!-- Legacy / Not launched -->
        <activity
            android:name="com.example.comp2000restaurantapp.MainActivity"/>

    </application>

</manifest>

